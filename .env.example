# Neon: DATABASE_URL = koneksi pooled, DIRECT_URL = koneksi direct (non-pooler, untuk migrate)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Halaman admin (/admin)
ADMIN_PASSWORD="ganti-password-custom"
# Acak, minimal 32 karakter. Buat dengan: openssl rand -base64 48
ADMIN_SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
